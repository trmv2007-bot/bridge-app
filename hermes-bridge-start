#!/bin/bash
# Hermes Bridge Server - Startup script
# Run this to start the bridge server

echo "Starting Hermes Bridge Server..."
echo "Port: 8080"
echo "Request file: /sdcard/bridge/ai_request.json"
echo "Response file: /sdcard/bridge/ai_response.json"
echo ""
echo "The server will run in the background."
echo "To check for messages, run: hermes-bridge-check"
echo "To stop the server, run: hermes-bridge-stop"
echo ""

# Kill any existing server
pkill -f hermes_bridge_server.py 2>/dev/null

# Start server in background
nohup python3 ~/bridge-app/hermes_bridge_server.py > /sdcard/bridge/server.log 2>&1 &

echo "Server started with PID: $!"
echo "Waiting for server to start..."
sleep 2

# Check if server is running
if pgrep -f hermes_bridge_server.py > /dev/null; then
    echo "Server is running!"
    echo "Test: curl http://localhost:8080/health"
else
    echo "Server failed to start. Check /sdcard/bridge/server.log"
fi
